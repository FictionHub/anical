# SEO landing pages under site/ (site/today/, site/<season>-<year>/) and
# sitemap.xml ARE committed now — generated by GitHub Actions and served as
# static files (no Netlify build step). So they are intentionally NOT ignored.

node_modules/
.DS_Store

# Local Netlify folder
.netlify

# ---------------------------------------------------------------------------
# Credentials. This repo is PUBLIC, so anything matched here would be readable
# by the whole internet the moment it were committed — and git history keeps it
# readable even after the file is deleted.
#
# Real secrets belong in GitHub Actions secrets and Netlify environment
# variables, never in a file in the tree. These patterns are the backstop for
# when someone runs `git add -A` without looking.
# ---------------------------------------------------------------------------
secrets.json
**/secrets.json
*.secrets.json
.env
.env.*
!.env.example
*.pem
*.key
vapid-*.json

# Local test scaffolding for the Netlify functions (a stubbed @netlify/blobs)
.blobstub/
