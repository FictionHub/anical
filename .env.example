# Local-only environment for `scripts/dev-server.mjs`. Copy to `.env` and fill
# in. `.env` is gitignored — the real values live in the Netlify site
# environment (Site configuration -> Environment variables), never in the tree.

# Groq key for the chat assistant: https://console.groq.com/keys
GROQ_API_KEY=

# Maintainer secret for POST /api/overrides. Must match the ADMIN_SECRET
# environment variable on Netlify. Needed to publish the offsets derived by
# scripts/ingest-crunchyroll.mjs — see scripts/capture-rows.mjs for the flow.
ADMIN_SECRET=

# Optional overrides — defaults are in netlify/functions/chat.mjs.
# GROQ_MODEL=openai/gpt-oss-120b          # tool calling; llama-3.1-8b-instant has a far larger daily budget
# GROQ_SEARCH_MODEL=groq/compound-mini    # web search; groq/compound is the bigger sibling
# CHAT_IP_DAILY=25
# CHAT_GLOBAL_DAILY=300

# Discord sign-in (identity only — it's how an event skin finds an account).
# Same application as the bot; the secret is on OAuth2 -> Client secret, and
# https://<site>/api/auth/callback must be registered there as a redirect.
# Leave blank to keep sign-in switched off; the site works without it.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs the session cookie. Any long random string: openssl rand -base64 48
SESSION_SECRET=
